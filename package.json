{
  "name": "aiexcel-monorepo",
  "private": true,
  "workspaces": [
    "addin",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=backend\" \"npm run dev --workspace=addin\"",
    "dev:web": "npm --prefix smart-excel-ai run dev",
    "build": "npm run build --workspace=backend && npm run build --workspace=addin",
    "build:web": "npm --prefix smart-excel-ai run build",
    "lint": "npm run lint --workspace=backend && npm run lint --workspace=addin"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
