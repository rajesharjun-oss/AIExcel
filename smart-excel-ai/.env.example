# Preferred: forward /api/ai and /api/translate to the AIExcel backend
# (backend/ workspace, powered by the Anthropic API). Start it with
# `npm run dev --workspace=backend` from the repository root.
AIEXCEL_BACKEND_URL=http://localhost:3001
AIEXCEL_BACKEND_KEY=

# Optional. If these are absent, the app falls back to local workbook tools.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional custom AI-compatible endpoint. When set, /api/ai forwards the workbook payload here.
AI_API_URL=
AI_API_KEY=
AI_MODEL=
