{
  "name": "smart-excel-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5177",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4177",
    "test": "tsc -p tsconfig.test.json && node -e \"require('fs').writeFileSync('tests-dist/package.json', '{\\\"type\\\":\\\"commonjs\\\"}')\" && node tests-dist/tests/run-tests.js",
    "test:e2e": "tsc -p tsconfig.test.json && node -e \"require('fs').writeFileSync('tests-dist/package.json', '{\\\"type\\\":\\\"commonjs\\\"}')\" && node tests-dist/tests/e2e/browser-grid.e2e.js",
    "test:all": "npm run test && npm run test:e2e"
  },
  "dependencies": {
    "lucide-react": "^0.562.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.0",
    "typescript": "^5.2.2",
    "vite": "^5.0.0"
  }
}
